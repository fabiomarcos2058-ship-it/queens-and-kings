rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada jogador só pode ler e salvar o próprio progresso
    match /jogadores/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == 'TxtfHnU2BXbcWpHkOSlDZQRpYNw1'; // a criadora pode ver o inventário
    }

    // Top global: todo mundo vê; cada um só escreve a própria linha
    match /ranking/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.method == 'delete' || (
          request.resource.data.trofeus is int
          && request.resource.data.trofeus >= 0 && request.resource.data.trofeus < 100000
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 16));
    }

    // Perfis públicos: quem está logado vê; cada um só escreve o próprio
    match /perfis/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.method == 'delete' || (request.resource.data.nome is string && request.resource.data.nome.size() <= 16));

      // Pedidos de amizade: quem manda cria com o próprio ID; os dois podem ler e apagar
      match /pedidos/{de} {
        allow read, delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == de);
        allow create, update: if request.auth != null && request.auth.uid == de && de != uid;
      }

      // Amigos: só vira amizade se existir um pedido entre os dois; qualquer um dos dois pode desfazer
      match /amigos/{outro} {
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == outro);
        allow create: if request.auth != null && (
          (request.auth.uid == uid && exists(/databases/$(database)/documents/perfis/$(uid)/pedidos/$(outro)))
          || (request.auth.uid == outro && exists(/databases/$(database)/documents/perfis/$(outro)/pedidos/$(uid))));
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == outro);
      }

      // Convites de x1: só amigos podem chamar
      match /convites/{de} {
        allow read, delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == de);
        allow create, update: if request.auth != null && request.auth.uid == de
          && exists(/databases/$(database)/documents/perfis/$(uid)/amigos/$(de));
      }
    }

    // Presentes da criadora: só a criadora manda; o jogador lê e apaga os dele
    match /presentes/{uid}/itens/{item} {
      allow read, delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == 'TxtfHnU2BXbcWpHkOSlDZQRpYNw1');
      allow create: if request.auth != null && request.auth.uid == 'TxtfHnU2BXbcWpHkOSlDZQRpYNw1';
    }

    // Clãs: qualquer pessoa logada vê; cada um só mexe na própria entrada; o líder pode remover membros
    match /clas/{claId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.lider == request.auth.uid
        && request.resource.data.membros.keys().hasOnly([request.auth.uid])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 20;
      allow update: if request.auth != null && (
        resource.data.lider == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
            && request.resource.data.membros.diff(resource.data.membros).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.membros.size() <= 50)
      );
      allow delete: if request.auth != null && resource.data.membros.keys().hasOnly([request.auth.uid]);

      // Chat: só membros leem e escrevem; mensagens de até 200 letras
      match /mensagens/{msg} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/clas/$(claId)).data.membros;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/clas/$(claId)).data.membros
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 200;
      }
    }
  }
}
