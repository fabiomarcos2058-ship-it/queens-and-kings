{
  "rules": {
    "config": {
      "versao": {
        ".read": true,
        ".write": "auth != null && newData.isNumber() && (!data.exists() || newData.val() > data.val()) && newData.val() <= now / 1000 + 3600"
      }
    },
    "salas": {
      "$codigo": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$codigo.length >= 4 && $codigo.length <= 6",
        "vagas": {
          "$vaga": {
            ".validate": "$vaga === 'azul' || $vaga === 'azul2' || $vaga === 'vermelho' || $vaga === 'vermelho2'"
          }
        }
      }
    },
    "aoVivo": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "assistindo": {
          "$quem": {
            ".write": "auth != null && auth.uid === $quem"
          }
        }
      }
    },
    "chefe": {
      "$id": {
        "jogadores": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nome','dano']) && newData.child('dano').isNumber() && newData.child('dano').val() >= (data.exists() ? data.child('dano').val() : 0) && newData.child('dano').val() <= (data.exists() ? data.child('dano').val() : 0) + 1000000",
            "nome": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "dano": {
              ".validate": "newData.isNumber()"
            },
            "lutas": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$outro": {
              ".validate": false
            }
          }
        }
      }
    },
    "torneios": {
      "$codigo": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$codigo.length >= 4 && $codigo.length <= 8"
      }
    }
  }
}